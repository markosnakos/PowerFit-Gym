        <plan id="plan-basic" accessLevel="gym">
            <planName>Basic</planName>
            <monthlyPrice>30.00</monthlyPrice>
            <features>
                <benefit>Fitness area access</benefit>
                <benefit>Locker room access</benefit>
                <limitation>Group classes not included</limitation>
            </features>
        </plan>
        <plan id="plan-plus" currency="EUR" accessLevel="group">
            <planName>Plus</planName>
            <monthlyPrice billingPeriod="monthly">42.00</monthlyPrice>
            <features>
                <benefit>Fitness area access</benefit>
                <benefit>Four group classes per week</benefit>
                <limitation>Personal training not included</limitation>
            </features>
        </plan>
        <plan id="plan-premium" currency="EUR" accessLevel="all">
            <planName>Premium</planName>
            <monthlyPrice billingPeriod="monthly">50.00</monthlyPrice>
            <features>
                <benefit>Unlimited group classes</benefit>
                <benefit>Fitness area access</benefit>
                <benefit>Monthly fitness assessment</benefit>
            </features>
        </plan>
        <plan id="plan-student" currency="EUR" accessLevel="group">
            <planName>Student</planName>
            <monthlyPrice billingPeriod="monthly">25.00</monthlyPrice>
            <features>
                <benefit>Fitness area access</benefit>
                <benefit>Two group classes per week</benefit>
                <limitation>Student identification required</limitation>
            </features>
        </plan>
    </membershipPlans>
