    <classes>
        <class id="class-yoga" trainerRef="trainer-anna" level="beginner" category="yoga" tags="low-impact mat-based">
            <className>Morning Yoga</className>
            <durationMinutes>60</durationMinutes>
            <description>Gentle yoga for <em>flexibility and relaxation</em>.</description>
            <equipment>Yoga mat</equipment>
        </class>
        <class id="class-hiit" trainerRef="trainer-james" level="intermediate" category="cardio" tags="intervals">
            <className>HIIT Training</className>
            <durationMinutes unit="minutes">45</durationMinutes>
            <description>High-intensity intervals combining cardio and strength.</description>
            <equipment>Timer</equipment>
            <equipment>Exercise mat</equipment>
        </class>
        <class id="class-strength" trainerRef="trainer-james" level="advanced" category="strength">
            <className>Strength Basics Plus</className>
            <durationMinutes unit="minutes">60</durationMinutes>
            <description>Progressive full-body resistance training.</description>
            <equipment>Dumbbells</equipment>
            <equipment>Barbell</equipment>
        </class>
        <class id="class-spin" trainerRef="trainer-maria" level="intermediate" category="cycling">
            <className>Indoor Cycling</className>
            <durationMinutes unit="minutes">45</durationMinutes>
            <description>Rhythm-based cardiovascular cycling.</description>
            <equipment>Stationary bike</equipment>
        </class>
        <class id="class-pilates" trainerRef="trainer-sophia" level="beginner" category="mobility">
            <className>Pilates Flow</className>
            <durationMinutes unit="minutes">50</durationMinutes>
            <description>Core stability, posture and controlled movement.</description>
            <equipment>Exercise mat</equipment>
            <equipment>Pilates ring</equipment>
        </class>
        <class id="class-functional" trainerRef="trainer-david" level="intermediate" category="strength">
            <className>Functional Circuit</className>
            <durationMinutes unit="minutes">50</durationMinutes>
            <description>Circuit training focused on everyday movement.</description>
            <equipment>Kettlebell</equipment>
            <equipment>Resistance band</equipment>
        </class>
        <class id="class-stretch" trainerRef="trainer-sophia" level="beginner" category="mobility">
            <className>Recovery and Stretch</className>
            <durationMinutes unit="minutes">40</durationMinutes>
            <description>Mobility and recovery for all fitness levels.</description>
        </class>
        <class id="class-power" trainerRef="trainer-james" level="advanced" category="strength">
            <className>Power Lifting</className>
            <durationMinutes unit="minutes">75</durationMinutes>
            <description>Technique-focused compound barbell lifts.</description>
            <equipment>Barbell</equipment>
            <equipment>Weight plates</equipment>
        </class>
    </classes>
