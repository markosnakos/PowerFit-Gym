    <memberDesk>
        <announcements>
            <announcement id="announcement-welcome" attachments="classCheckIn sharedEquipment">
                <announcementTitle>Welcome to the member desk</announcementTitle>
                <announcementBody>&frontDesk;</announcementBody>
            </announcement>
            <announcement id="announcement-equipment" attachments="sharedEquipment">
                <announcementTitle>Ready for the next class</announcementTitle>
                <announcementBody>Return shared equipment to its marked storage area after your session and report any damage to your trainer.</announcementBody>
            </announcement>
            <announcement id="announcement-support">
                <announcementTitle>Questions about your membership?</announcementTitle>
                <announcementBody>
                    <paragraph>Speak to reception about your plan or ask a trainer for advice <em>before booking a new class</em>.</paragraph>
                </announcementBody>
            </announcement>
        </announcements>
        <guides>
            <guide id="guide-check-in" resource="classCheckIn" format="plainText">
                <guideTitle>Class check-in guide</guideTitle>
                <guideDescription>Arrival times, reservations and checking in at reception.</guideDescription>
            </guide>
            <guide id="guide-equipment" resource="sharedEquipment">
                <guideTitle>Shared equipment guide</guideTitle>
                <guideDescription>Collecting, returning and reporting problems with shared equipment.</guideDescription>
            </guide>
        </guides>
    </memberDesk>
