<!-- PowerFit Gym vocabulary. -->
<!-- Text entities and media declarations. -->
<!ENTITY % inline "(#PCDATA|em|strong)*">
<!ENTITY gymSlogan "Train Strong. Live Well.">
<!ENTITY frontDesk SYSTEM "resources/front-desk.ent">
<!ENTITY % gymMedia SYSTEM "gym-media.dtd">
%gymMedia;

<!-- Gym details, collections, and optional member desk. -->
<!ELEMENT gym (name, tagline, location, contact?, membershipPlans, trainers, rooms, members, classes, schedule, memberDesk?)>
<!ATTLIST gym version CDATA #FIXED "1.1">
<!ELEMENT name (#PCDATA)>
<!ELEMENT tagline (#PCDATA)>
<!ELEMENT location (street, city, postalCode?)>
<!ELEMENT street (#PCDATA)>
<!ELEMENT city (#PCDATA)>
<!ELEMENT postalCode (#PCDATA)>
<!ELEMENT contact (email, phone?)>
<!ELEMENT email (#PCDATA)>
<!ELEMENT phone (#PCDATA)>

<!-- Membership plans and access conditions. -->
<!ELEMENT membershipPlans (plan+)>
<!ELEMENT plan (planName, monthlyPrice, features)>
<!ATTLIST plan id ID #REQUIRED
               currency (EUR|USD|GBP) "EUR"
               accessLevel (gym|group|all) #REQUIRED>
<!ELEMENT planName (#PCDATA)>
<!ELEMENT monthlyPrice (#PCDATA)>
<!ATTLIST monthlyPrice billingPeriod (monthly) #FIXED "monthly">
<!ELEMENT features (benefit|limitation)+>
<!ELEMENT benefit (#PCDATA)>
<!ELEMENT limitation (#PCDATA)>

<!-- Trainers: optional phone and zero-or-more certifications. -->
<!ELEMENT trainers (trainer+)>
<!ELEMENT trainer (fullName, specialty, email, phone?, certification*)>
<!ATTLIST trainer id ID #REQUIRED employment (full-time|part-time|contract) #REQUIRED>
<!ELEMENT fullName (#PCDATA)>
<!ELEMENT specialty (#PCDATA)>
<!ELEMENT certification (#PCDATA)>

<!-- Rooms and facilities. -->
<!ELEMENT rooms (room+)>
<!ELEMENT room (roomName, capacity, amenities?)>
<!ATTLIST room id ID #REQUIRED
               type (studio|weights|functional|cycling) #REQUIRED
               code NMTOKEN #IMPLIED>
<!ELEMENT roomName (#PCDATA)>
<!ELEMENT capacity (#PCDATA)>
<!ELEMENT amenities (amenity+)>
<!ELEMENT amenity (#PCDATA)>

<!-- Member details and subscription references. -->
<!ELEMENT members (member+)>
<!ELEMENT member (fullName, age, email, phone?, joinedOn, emergencyContact?)>
<!ATTLIST member id ID #REQUIRED
                 planRef IDREF #REQUIRED
                 status (active|paused|cancelled) "active">
<!ELEMENT age (#PCDATA)>
<!ELEMENT joinedOn (#PCDATA)>
<!-- Emergency contacts provide either a phone number or an email address. -->
<!ELEMENT emergencyContact (fullName, (phone|email))>

<!-- Class references a trainer, equipment is optional and repeatable. -->
<!ELEMENT classes (class+)>
<!ELEMENT class (className, durationMinutes, description, equipment*)>
<!ATTLIST class id ID #REQUIRED
                trainerRef IDREF #REQUIRED
                level (beginner|intermediate|advanced) #REQUIRED
                category (yoga|strength|cardio|cycling|mobility) #REQUIRED
                tags NMTOKENS #IMPLIED>
<!ELEMENT className (#PCDATA)>
<!ELEMENT durationMinutes (#PCDATA)>
<!ATTLIST durationMinutes unit (minutes) #FIXED "minutes">
<!ELEMENT description %inline;>
<!ELEMENT equipment (#PCDATA)>

<!-- Weekly sessions and registrations. -->
<!ELEMENT schedule (session+)>
<!ELEMENT session (startTime, endTime, registrations?, note?)>
<!ATTLIST session id ID #REQUIRED
                  classRef IDREF #REQUIRED
                  roomRef IDREF #REQUIRED
                  day (Monday|Tuesday|Wednesday|Thursday|Friday|Saturday|Sunday) #REQUIRED>
<!ELEMENT startTime (#PCDATA)>
<!ELEMENT endTime (#PCDATA)>
<!ELEMENT registrations EMPTY>
<!ATTLIST registrations memberRefs IDREFS #REQUIRED>
<!ELEMENT note %inline;>

<!-- Member announcements and guide catalogue. -->
<!ELEMENT memberDesk (announcements, guides)>
<!ELEMENT announcements (announcement+)>
<!ELEMENT announcement (announcementTitle, announcementBody)>
<!ATTLIST announcement id ID #REQUIRED attachments ENTITIES #IMPLIED>
<!ELEMENT announcementTitle (#PCDATA)>
<!-- ANY permits text and any declared elements, including paragraphs and checklists. -->
<!ELEMENT announcementBody ANY>
<!ELEMENT guides (guide+)>
<!ELEMENT guide (guideTitle, guideDescription?)>
<!ATTLIST guide id ID #REQUIRED
                resource ENTITY #REQUIRED
                format NOTATION (plainText) "plainText">
<!ELEMENT guideTitle (#PCDATA)>
<!ELEMENT guideDescription (#PCDATA)>
<!-- Inline markup in text fields. -->
<!ELEMENT paragraph %inline;>
<!ELEMENT em (#PCDATA)>
<!ELEMENT strong (#PCDATA)>
<!ELEMENT checklist (item+)>
<!ELEMENT item %inline;>
